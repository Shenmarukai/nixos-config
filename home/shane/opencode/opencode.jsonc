{
  "$schema": "https://opencode.ai/config.json",

  "theme": "catppuccin",
  "autoupdate": false,

  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": false
    },
    "diff_style": "auto"
  },

  "compaction": {
    "auto": true,
    "prune": true
  },

  "permission": {
    "bash": "ask",
    "edit": "ask",
    "skill": "ask",
    "task": "ask"
  },

  "default_agent": "plan",

  "mcp": {
    "github-read-only": {
      // https://github.com/github/github-mcp-server
      "type": "local",
      "enabled": false,
      "command": [
        "github-mcp-server-gh",
        "--read-only",
        "--dynamic-toolsets"
      ]
    },
    "github-read-write": {
      // https://github.com/github/github-mcp-server
      "type": "local",
      "enabled": false,
      "command": [
        "github-mcp-server-gh",
        "--dynamic-toolsets"
      ]
    },
    //"asana": {
    //  // https://developers.asana.com/docs/using-asanas-mcp-server
    //  "type": "local",
    //  "enabled": false,
    //  "command": [
    //    "mcp-proxy",
    //    "https://mcp.asana.com/sse"
    //  ],
    //  "environment": {
    //    "API_ACCESS_TOKEN": "{file:~/.config/opencode/asana-token}"
    //  }
    //},
    "math-mcp": {
      // https://github.com/EthanHenrickson/math-mcp
      "type": "local",
      "enabled": false,
      "command": [
        "math-mcp"
      ]
    },
    "nixos": {
      // https://github.com/utensils/mcp-nixos
      "type": "local",
      "enabled": false,
      "command": [
        "mcp-nixos"
      ]
    },
    "global-rag": {
      // https://github.com/shinpr/mcp-local-rag
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "mcp-local-rag@0.5.3"
      ],
      "environment": {
        "DB_PATH": "~/.cache/opencode/rag/lancedb",
        "CACHE_DIR": "~/.cache/opencode/rag/models"
      }
    },
    "local-rag": {
      // https://github.com/shinpr/mcp-local-rag
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "mcp-local-rag@0.5.3"
      ],
      "environment": {
        "DB_PATH": "./.rag/lancedb",
        "CACHE_DIR": "./.rag/models"
      }
    },
    "ida-pro": {
      // https://github.com/mrexodia/ida-pro-mcp
      "type": "remote",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": false
    }
  },

  "plugin": [
    "opencode-sessions@1.0.0",                    // https://github.com/malhashemi/opencode-sessions
    "@mohak34/opencode-notifier@0.1.15",          // https://github.com/mohak34/opencode-notifier
    "@ramarivera/opencode-model-announcer@1.0.2", // https://github.com/ramarivera/opencode-model-announcer
    "@tarquinen/opencode-dcp@1.2.7",              // https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
    "@openspoon/subtask2@0.2.10",                 // https://github.com/spoons-and-mirrors/subtask2
    //"opencode-swarm-plugin@0.60.0",             // https://github.com/joelhooks/swarm-tools
    "opencode-websearch-cited@1.2.0"              // https://github.com/ghoulr/opencode-websearch-cited
  ],

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3 4b Instruct (q4_k_xl)"
        },
        "qwen3-4b-thinking-2507": {
          "name": "Qwen3 4b Thinking (q4_k_xl)"
        },
        "qwen3-30b-a3b-instruct-2507": {
          "name": "Qwen3 30b A3b Instruct (q4_k_xl)"
        },
        "qwen3-30b-a3b-thinking-2507": {
          "name": "Qwen3 30b A3b Thinking (q4_k_xl)"
        },
        "qwen3-coder-30b-a3b-instruct": {
          "name": "Qwen3 Coder 30b A3b Instruct (q4_k_xl)"
        },
        "qwen3-coder-30b-a3b-instruct-1m": {
          "name": "Qwen3 Coder 30b A3b Instruct 1m (q4_k_xl)"
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (q4_k_xl)"
        },
        "glm-4.7-flash-reap-23b-a3b": {
          "name": "GLM 4.7 Flash REAP 23b A3b (q4_k_xl)"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30b A3b (q4_k_xl)"
        },
        "gpt-oss-20b": {
          "name": "GPT OSS 20b (f16)"
        }
      }
    }
  }
}
