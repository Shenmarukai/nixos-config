{
  "$schema": "https://opencode.ai/config.json",

  "theme": "catppuccin",
  "autoupdate": true,

  "model": "{env:OPENCODE_MAIN_MODEL}",
  "small_model": "{env:OPENCODE_PLAN_MODEL}",
 
  "permission": {
    "bash": "ask",
    "edit": "ask"
  },
 
  "mcp": {
    "ida-pro": {
      "type": "remote",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": true
    }
  },
 
  "plugin": [

    "opencode-sessions@1.0.0",
    "@ramarivera/opencode-model-announcer@1.0.2"
  ],

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT OSS 120b"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30b a3b"
        }
      }
    }
  }
}
