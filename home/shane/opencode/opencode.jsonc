{
  "$schema": "https://opencode.ai/config.json",

  "theme": "catppuccin",
  "autoupdate": true,

  "model": "{env:OPENCODE_MAIN_MODEL}",
  "small_model": "{env:OPENCODE_PLAN_MODEL}",

  "permission": {
    "bash": "ask",
    "edit": "ask"
  },

  "plugin": [
    "opencode-sessions",
    //"/home/shane/code/shane/opencode-general-harness"
  ],

  //"instructions": [
  //  "{file:{env:HOME}/.config/opencode/orchestration.md}"
  //],

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT OSS 120b"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30b a3b"
        }
      }
    }
  }
}
