{
  "$schema": "https://opencode.ai/config.json",

  "theme": "catppuccin",
  "autoupdate": false,

  "compaction": {
    "auto": true,
    "prune": true
  },

  "permission": {
    "bash": "ask",
    "edit": "ask",
    "skill": "ask",
    "task": "ask"
  },

  "mcp": {
    "github-read-only": {
      // https://github.com/github/github-mcp-server
      "type": "local",
      "enabled": false,
      "command": [
        "github-mcp-server-gh",
        "--read-only",
        "--dynamic-toolsets"
      ]
    },
    "github-read-write": {
      // https://github.com/github/github-mcp-server
      "type": "local",
      "enabled": false,
      "command": [
        "github-mcp-server-gh",
        "--dynamic-toolsets"
      ]
    },
    //"asana": {
    //  // https://developers.asana.com/docs/using-asanas-mcp-server
    //  "type": "local",
    //  "enabled": false,
    //  "command": [
    //    "mcp-proxy",
    //    "https://mcp.asana.com/sse"
    //  ],
    //  "environment": {
    //    "API_ACCESS_TOKEN": "{file:~/.config/opencode/asana-token}"
    //  }
    //},
    "math-mcp": {
      // https://github.com/EthanHenrickson/math-mcp
      "type": "local",
      "enabled": false,
      "command": [
        "math-mcp"
      ]
    },
    "nixos": {
      // https://github.com/utensils/mcp-nixos
      "type": "local",
      "enabled": false,
      "command": [
        "mcp-nixos"
      ]
    },
    "global-rag": {
      // https://github.com/shinpr/mcp-local-rag
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "mcp-local-rag@0.5.3"
      ],
      "environment": {
        "DB_PATH": "~/.cache/opencode/rag/lancedb",
        "CACHE_DIR": "~/.cache/opencode/rag/models"
      }
    },
    "local-rag": {
      // https://github.com/shinpr/mcp-local-rag
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "mcp-local-rag@0.5.3"
      ],
      "environment": {
        "DB_PATH": "./.rag/lancedb",
        "CACHE_DIR": "./.rag/models"
      }
    },
    "ida-pro": {
      // https://github.com/mrexodia/ida-pro-mcp
      "type": "remote",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": false
    }
  },

  "plugin": [
    "opencode-sessions@1.0.0", // https://github.com/malhashemi/opencode-sessions
    "@mohak34/opencode-notifier@0.1.13", // https://github.com/mohak34/opencode-notifier
    "@ramarivera/opencode-model-announcer@1.0.2", // https://github.com/ramarivera/opencode-model-announcer
    "@tarquinen/opencode-dcp@1.2.1", // https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
    //"@openspoon/subtask2@0.2.9", // https://github.com/spoons-and-mirrors/subtask2
    //"@swarmtools/evals@0.2.29", // https://github.com/joelhooks/swarm-tools
    //"opencode-websearch-cited@1.2.0", // https://github.com/ghoulr/opencode-websearch-cited
    //"@franlol/opencode-md-table-formatter@0.0.3", // https://github.com/franlol/opencode-md-table-formatter
    //"opencode-devcontainers@0.2.0", // https://github.com/athal7/opencode-devcontainers
    //"opencode-pilot@0.13.0", // https://github.com/athal7/opencode-pilot
    //"opencode-mystatus@1.2.2" // https://github.com/vbgate/opencode-mystatus
  ],

  //"command": {
  //  "mystatus": {
  //    "description": "Query quota usage for all AI accounts",
  //    "template": "Use the mystatus tool to query quota usage. Return the result as-is without modification."
  //  }
  //},

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3-14b": {
          "name": "Qwen3 14b"
        },
        "qwen3-4b-instruct-2507@q4_k_xl": {
          "name": "Qwen3 4b Instruct (i4)"
        },
        "qwen3-4b-thinking-2507@q4_k_xl": {
          "name": "Qwen3 4b Thinking (i4)"
        },
        "qwen3-4b-instruct-2507@q8_k_xl": {
          "name": "Qwen3 4b Instruct (i8)"
        },
        "qwen3-4b-thinking-2507@q8_k_xl": {
          "name": "Qwen3 4b Thinking (i8)"
        },
        "qwen3-30b-a3b-instruct-2507": {
          "name": "Qwen3 30b A3b Instruct"
        },
        "qwen3-30b-a3b-thinking-2507": {
          "name": "Qwen3 30b A3b Thinking"
        },
        "qwen3-coder-30b-a3b-instruct": {
          "name": "Qwen3 Coder 30b A3b Instruct"
        },
        "qwen3-coder-30b-a3b-instruct-1m": {
          "name": "Qwen3 Coder 30b A3b Instruct 1m"
        },
        "gpt-oss-20b@q4_k_xl": {
          "name": "GPT OSS 20b (i4)"
        },
        "gpt-oss-20b@q8_k_xl": {
          "name": "GPT OSS 20b (i8)"
        },
        "gpt-oss-20b@f16": {
          "name": "GPT OSS 20b (f16)"
        },
        "gpt-oss-120b": {
          "name": "GPT OSS 120b"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30b a3b"
        }
      }
    }
  }
}
