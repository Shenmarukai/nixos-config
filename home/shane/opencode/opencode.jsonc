{
  "$schema": "https://opencode.ai/config.json",

  "theme": "catppuccin",
  "autoupdate": true,

  "permission": {
    "bash": "ask",
    "edit": "ask"
  },

  "mcp": {
    "ida-pro": {
      "type": "remote",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": true
    }
  },

  "plugin": [
    "opencode-sessions@1.0.0",
    "@mohak34/opencode-notifier@0.1.13",
    "@ramarivera/opencode-model-announcer@1.0.2",
    "@zenobius/opencode-skillful@1.2.3",
    "@openspoon/subtask2@0.2.9",
    "@swarmtools/evals@0.2.29",
    "@tarquinen/opencode-dcp@1.2.1",
    "opencode-websearch-cited@1.2.0",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "opencode-devcontainers@0.2.0",
    "opencode-pilot@0.13.0",
    "opencode-mystatus@1.2.2"
  ],

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT OSS 120b"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30b a3b"
        }
      }
    }
  }
}
